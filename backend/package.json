{
  "name": "@invoiceguard/api",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "test": "vitest run",
    "db:generate": "prisma generate --schema database/prisma/schema.prisma",
    "db:push": "prisma db push --schema database/prisma/schema.prisma",
    "db:migrate:deploy": "prisma migrate deploy --schema database/prisma/schema.prisma",
    "db:studio": "prisma studio --schema database/prisma/schema.prisma"
  },
  "dependencies": {
    "@invoiceguard/database": "file:./database",
    "@prisma/client": "^6.2.1",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "multer": "^2.5.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/multer": "^2.3.0",
    "@types/node": "^22.10.5",
    "prisma": "^6.19.3",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^4.1.12"
  },
  "overrides": {
    "deepmerge-ts": "8.0.0"
  }
}
